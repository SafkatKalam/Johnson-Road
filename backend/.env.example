# Copy to backend/.env. backend/.env is never committed. Local development only.
# Replace every change-me with your own value (for example a long random string).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=johnson_road

# Docker PostgreSQL 16 on host port 5430. "postgres://" and "postgresql://" are both accepted.
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and the connection stalls.
# Required: the API refuses to start without it. The password must match POSTGRES_PASSWORD.
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5430/johnson_road

# Local file storage: MinIO in Docker (API 9110, console 9111)
S3_ENDPOINT=http://127.0.0.1:9110
S3_REGION=us-east-1
S3_BUCKET=johnson-road-media
S3_ACCESS_KEY_ID=change-me-access-key
S3_SECRET_ACCESS_KEY=change-me-secret-key

BACKEND_PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

# Sign-in: your Supabase project URL (public; no secret needed - the backend checks tokens with the project's
# public signing keys). Without it every protected route answers 503. Supabase > Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional extras (not read by the code yet). Keep real values only in backend/.env.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=sb_publishable_change-me
# REQUIRED for invitations: without it nobody can accept one (the server asks Supabase whether an address was confirmed).
SUPABASE_SECRET_KEY=sb_secret_change-me   # server only; never put it in frontend/.env

# AI detector. "stub" needs nothing and finds nothing. For the real model: pip install -r requirements-ai.txt,
# then MODEL=yolo8, MODEL_PATH=yolov8n.pt (relative to backend/) and DEVICE=cuda:0 or cpu.
# A model file that is missing is an error: the server never picks another model for you.
MODEL=stub
DEVICE=cpu
ENABLE_WARMUP=true
